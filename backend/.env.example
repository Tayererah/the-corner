# Django Backend Configuration
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key-in-production
DJANGO_DEBUG=False

# If hosted on Railway, Render, Supabase, or Neon, set DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Or configure individual DB variables:
DB_NAME=the_corner_db
DB_USER=corner_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# ImageKit Configuration (for student listing photos)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key
